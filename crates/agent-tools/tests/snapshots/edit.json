  {
    "description": "Compute versioned deterministic swings, trend, levels, volume profile or volatility over returned history.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "Unix seconds UTC",
          "type": "integer"
        },
        "limit": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "swings",
            "trend",
            "levels",
            "volume_profile",
            "volatility"
          ],
          "type": "string"
        },
        "symbol": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "timeframe": {
          "default": "1D",
          "enum": [
            "1m",
            "2m",
            "3m",
            "5m",
            "15m",
            "30m",
            "1H",
            "2H",
            "4H",
            "1D",
            "1W",
            "1M",
            "3M"
          ],
          "type": "string"
        },
        "to": {
          "description": "Unix seconds UTC",
          "type": "integer"
        },
        "top": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "symbol",
        "mode"
      ],
      "type": "object"
    },
    "kind": "data",
    "mutating": false,
    "name": "analyze",
    "needs_confirmation": false
  },
