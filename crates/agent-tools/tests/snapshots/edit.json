  {
    "description": "Compare 2–8 symbols numerically on common finished bars: return, annualised volatility, drawdown, ATR, relative strength, correlation and beta to the first symbol. Does not change the chart.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "Unix seconds UTC",
          "maximum": 253370764799,
          "minimum": -62135596800,
          "type": [
            "integer",
            "null"
          ]
        },
        "lookback": {
          "default": 120,
          "description": "Finished bars per symbol; omit when using from/to. Date ranges are capped at 1000 bars per symbol.",
          "maximum": 1000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "symbols": {
          "description": "First symbol is the base.",
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        },
        "timeframe": {
          "default": "1D",
          "enum": [
            "1m",
            "2m",
            "3m",
            "5m",
            "15m",
            "30m",
            "1H",
            "2H",
            "4H",
            "1D",
            "1W",
            "1M",
            "3M"
          ],
          "type": "string"
        },
        "to": {
          "description": "Unix seconds UTC",
          "maximum": 253370764799,
          "minimum": -62135596800,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "symbols",
        "timeframe"
      ],
      "type": "object"
    },
    "kind": "data",
    "mutating": false,
    "name": "compare_symbols",
    "needs_confirmation": false
  },
  {
    "description": "Create a drawing for an explicit symbol. Rectangles normalize inverted anchors, snap times to loaded bars and clamp the end to the last bar; start must be loaded and both dimensions non-zero. Pass source_timeframe from analyze/read_data for zone labels. all_symbols defaults false.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "all_symbols": {
          "default": false,
          "type": "boolean"
        },
        "anchors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "price": {
                "type": "number"
              },
              "time": {
                "description": "Unix seconds UTC",
                "maximum": 253370764799,
                "minimum": -62135596800,
                "type": "integer"
              }
            },
            "required": [
              "time",
              "price"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "chart_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "horizontal",
            "vertical",
            "trend_line",
            "ray",
            "rectangle",
            "text"
          ],
          "type": "string"
        },
        "label": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "source_timeframe": {
          "description": "Analysis timeframe; falls back to the chart timeframe when omitted.",
          "enum": [
            "1m",
            "2m",
            "3m",
            "5m",
            "15m",
            "30m",
            "1H",
            "2H",
            "4H",
            "1D",
            "1W",
            "1M",
            "3M",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "zone_role": {
          "enum": [
            "support",
            "resistance",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "symbol",
        "kind",
        "anchors"
      ],
      "type": "object"
    },
    "kind": "live",
    "mutating": true,
    "name": "create_drawing",
    "needs_confirmation": false
